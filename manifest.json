{
   "action": {
      "default_popup": "popup.html"
   },
   "background": {
      "service_worker": "src/js/sw.js"
   },
   "content_scripts": [
      {
         "all_frames": true,
         "css": [
            "src/css/styles.css"
         ],
         "js": [
            "src/js/content-script.js"
         ],
         "match_about_blank": true,
         "matches": [
            "https://*.google.com/*"
         ]
      }
   ],
   "name": "Amar Reviews",
   "description": "AI-powered reviews to Google maps chrome extension. Free & Premium services available.",
   "host_permissions": [
      "https://*.google.com/*",
      "https://*.amar.reviews/*"
   ],
   "icons": {
      "128": "src/images/128x128.png",
      "16": "src/images/icon16.png",
      "32": "src/images/32x32.png",
      "48": "src/images/icon48.png"
   },
   "manifest_version": 3,
   "oauth2": {
      "client_id": "923043351236-gkne7r1njk2s8vqqn2e2kpv09337n9k6.apps.googleusercontent.com",
      "scopes": [
         "openid",
         "profile",
         "email"
      ]
   },
   "options_page": "options.html",
   "options_ui": {
      "open_in_tab": true,
      "page": "options.html"
   },
   "permissions": [
      "storage",
      "identity",
      "identity.email",
      "notifications"
   ],
   "update_url": "https://clients2.google.com/service/update2/crx",
   "version": "1.0.0",
   "web_accessible_resources": [
      {
         "base_url": "https://google-map-ai-reply.test",
         "description": "Amar Reviews Web Accessible Resources",
         "matches": [
            "https://*.google.com/*"
         ],
         "resources": [
            "src/images/*",
            "login.html"
         ],
         "use_dynamic_url": true
      }
   ]
}